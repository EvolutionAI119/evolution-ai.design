# =====================================================================
# EVOLUTION AI 后端环境变量样板
# 用法：复制为 .env 后按需修改（cp .env.example .env）
# 注意：.env 含真实密钥，已被 .gitignore 排除，绝不提交入库
# =====================================================================

# ---------- 运行环境 ----------
# development = 本地开发（CORS 放行任意 Origin、500 响应含异常详情）
# production  = 生产（强制校验 SECRET_KEY 强度、禁止 DEBUG=true、CORS 严格白名单）
ENVIRONMENT=development
# 生产环境必须为 false（production 下 DEBUG=true 会拒绝启动）
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ---------- 数据库 ----------
# 本地开发默认 SQLite（零依赖）；生产建议 PostgreSQL（连接池/并发能力更强）
# PostgreSQL 使用 psycopg3 驱动，连接串前缀 postgresql+psycopg://
#   DATABASE_URL=postgresql+psycopg://evolution:CHANGE_ME@localhost:5432/evolution
# Schema 版本化迁移（Alembic，在 backend/ 目录执行）：
#   全新库建表：              python -m alembic upgrade head
#   既有 SQLite 库补登记：    python -m alembic stamp head
#   SQLite→PG 数据一次性迁移：python scripts/migrate_sqlite_to_pg.py --help
DATABASE_URL=sqlite:///./evolution_ai.db

# ---------- JWT 鉴权 ----------
# 生产环境必须覆盖为 >=32 位随机字符串：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=evolution-ai-dev-secret-change-me-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---------- 微信扫码登录（开放平台，可选） ----------
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_REDIRECT_URI=
FRONTEND_URL=http://127.0.0.1:5173

# ---------- 微信公众号网页授权（可选） ----------
MP_APPID=
MP_SECRET=
MP_REDIRECT_URI=

# ---------- Redis 会话持久化 ----------
SESSION_USE_REDIS=false
# 支持密码：redis://:yourpassword@host:6379/0（生产建议 Redis 设置 requirepass）
SESSION_REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400
SESSION_REDIS_PREFIX=evoai:session:

# ---------- CORS 与安全响应头 ----------
# 逗号分隔的允许 Origin 白名单（生产填前端实际域名，如 https://evolution-ai.design）
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
# 是否去除 server: uvicorn 信息泄露头
HIDE_SERVER_HEADER=true

# ---------- API 限流（slowapi，按客户端 IP） ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=10/minute

# ---------- AI 训练后端 ----------
TRAINING_BACKEND=pytorch
TRAINING_MAX_EPOCHS=100
TRAINING_MAX_CONCURRENT=2

# ---------- 上传限制 ----------
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.glb,.gltf,.obj,.stl,.fbx,.igs,.iges,.step,.stp

# ---------- LLM 提供商 API Key（密钥隔离：每个平台独立凭证） ----------
# 解析顺序：EVOAI_{PROVIDER}_KEY（服务级兜底） → 用户在「API Key 管理」中自填（DB 加密）
# 留空表示该平台不启用服务级兜底，仅已配置个人 Key 的登录用户可用
# ⚠️ 轮换流程：平台控制台生成新 Key → 更新此处 → 重启后端 → 验证 → 禁用旧 Key
#    同步更新 backend/.key-registry.json 记录版本与状态（不含明文密钥）
EVOAI_ERNIE_KEY=
EVOAI_QWEN_KEY=
EVOAI_HUNYUAN_KEY=
EVOAI_DOUBAO_KEY=
EVOAI_DEEPSEEK_KEY=
EVOAI_KIMI_KEY=
EVOAI_SILICONFLOW_KEY=
