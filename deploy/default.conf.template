# Nginx server block 模板（官方 nginx:alpine 镜像在启动时会用 envsubst 渲染 templates/*.template → conf.d/default.conf）
# 支持注入的环境变量：
#   BACKEND_HOST        后端服务名（compose service 名，默认 backend）
#   BACKEND_PORT        后端端口（默认 8000）
#   FRONTEND_SERVER_NAME对外 server_name（默认 _，即通配）
#   HSTS_MAX_AGE        HTTPS 部署时填 31536000（1 年），HTTP 部署保持 0
# 参考：https://github.com/nginxinc/docker-nginx/tree/master/stable/alpine

server {
    listen       80;
    server_name  ${FRONTEND_SERVER_NAME};

    # --- 静态 SPA 资源根目录（来自 frontend.Dockerfile COPY /app/dist → 此目录） ---
    root   /usr/share/nginx/html;
    index  index.html;

    # --- 统一的响应头：安全 + 缓存；后端也会发，这里作为外层增强 ---
    # 注意：add_header 在不同 location 里会被「覆盖」，所以用 always 参数确保错误页也带
    add_header X-Content-Type-Options      "nosniff"                       always;
    add_header X-Frame-Options             "DENY"                          always;
    add_header Referrer-Policy             "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy          "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()" always;
    add_header Strict-Transport-Security   "max-age=${HSTS_MAX_AGE}; includeSubDomains" always;
    # CSP 用后端策略（后端按路由可能不同），避免双层冲突；如果需要纯前端强约束可取消下一行注释
    # add_header Content-Security-Policy     "default-src 'self'; img-src 'self' data: https: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https: ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # ==============================================================
    # [A] 反代 /api/v1/ 和 /docs /redoc /openapi.json → backend:8000
    #     确保：真实 IP、Proto、Host、超时都正确传递
    # ==============================================================
    location ~ ^/(api/v1|docs|redoc|openapi\.json)(.*) {
        proxy_pass         http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Request-ID      $request_id;

        # 大文件上传：禁用请求缓冲，避免 nginx 吃内存（50MB STEP/IGES 文件）
        proxy_request_buffering off;
        proxy_buffering off;

        # 长请求 / 导出可能需要更长时间
        proxy_read_timeout     300s;
        proxy_send_timeout     300s;
        proxy_connect_timeout   10s;

        # 后端的响应头不剥离；允许前端拿到 Content-Disposition / ETag 等
        proxy_pass_header Content-Disposition;
        proxy_pass_header ETag;
    }

    # 兼容旧版 Vite 代理里的 /api/ide 反代（Trae AI image gen），若未配置不启用（返回 404）
    location ~ ^/api/ide/(.*) {
        return 404;  # 生产环境一般不在前端容器里直接绕过到第三方 API；可按需在反代层单独配置
    }

    # ==============================================================
    # [B] 静态品牌图 / SVG：长缓存（构建时 hash 不变，可安全缓存 1y）
    # ==============================================================
    location ~* \.(?:jpg|jpeg|png|gif|webp|avif|svg|ico)$ {
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        # 覆盖父级 add_header：重新声明安全头（nginx 的 add_header 按 location 覆盖规则）
        add_header X-Content-Type-Options      "nosniff"                       always;
        add_header X-Frame-Options             "DENY"                          always;
        add_header Referrer-Policy             "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy          "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()" always;
        try_files $uri =404;
    }

    # ==============================================================
    # [C] CSS/JS：assets/ 下由 Vite 带 hash 命名 → 强缓存
    # ==============================================================
    location /assets/ {
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options      "nosniff"                       always;
        add_header X-Frame-Options             "DENY"                          always;
        add_header Referrer-Policy             "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy          "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()" always;
        try_files $uri =404;
    }

    # ==============================================================
    # [D] SPA 路由兜底：所有未知路径回退到 index.html（vue-router history 模式）
    # ==============================================================
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options      "nosniff"                       always;
        add_header X-Frame-Options             "DENY"                          always;
        add_header Referrer-Policy             "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy          "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()" always;
        try_files $uri $uri/ /index.html;
    }

    # ==============================================================
    # [E] 禁止访问隐藏文件（.env / .git / .DS_Store）
    # ==============================================================
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
