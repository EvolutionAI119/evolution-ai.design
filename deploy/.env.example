# =====================================================================
#  Evolution-Ai.Design — 环境变量示例（生产部署用）
# ---------------------------------------------------------------------
#  拷贝到项目根目录后按需修改：  cp deploy/.env.example ./.env
#  变量名对应 backend/app/config.py 的 Settings 字段（pydantic-settings
#  自动从环境变量读取，命名完全一致）。
# =====================================================================

# ---------- 基本部署 ----------
# environment（development/production）
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
# 对外暴露 HTTP 端口（docker-compose 映射到 nginx 容器 80）
HTTP_PORT=80

# ---------- 域名 & CORS ----------
# 前端 server_name（nginx default_server 通配即可）
FRONTEND_SERVER_NAME=_
# 允许的跨域源（逗号分隔）；必须包含所有用户会访问的协议+域名+端口
# 示例：https://evoai.example.com,http://localhost:5173,http://127.0.0.1
CORS_ALLOW_ORIGINS=http://127.0.0.1,http://localhost

# ---------- HTTPS/HSTS ----------
# HTTPS 部署（含证书/反代）时建议改为 31536000（=1 年，包含子域）
SEC_HEADER_HSTS_MAX_AGE=0

# ---------- 文件上传 ----------
# 与 nginx 的 client_max_body_size 保持对齐（建议比 MAX_FILE_SIZE 略大）
MAX_FILE_SIZE=52428800

# ---------- 会话持久化（默认内存；要持久化打开 Redis service 后改） ----------
SESSION_USE_REDIS=false
SESSION_REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=86400

# ---------- 构建加速（国内网络可填写） ----------
# 后端 Python
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
# 前端 npm
NPM_REGISTRY=https://registry.npmmirror.com
